# ==============================================================================
# Scuole di Psicoterapia Cognitiva — Artificial Intelligence Platform (AIP)
# File di configurazione delle variabili d'ambiente (TEMPLATE)
#
# ISTRUZIONI:
# 1. Crea una copia di questo file e rinominala in `.env` (nella cartella aip/)
# 2. Compila i valori con le credenziali del tuo ambiente di sviluppo o produzione
# 3. NON COMMETTERE MAI IL FILE `.env` NEL REPOSITORY GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurazione Generale Applicazione
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME="Scuole di Psicoterapia Cognitiva — AIP"

# Chiave segreta per le sessioni HTTP e i token CSRF.
# Generabile in Python con: secrets.token_hex(32)
# In produzione deve essere casuale, indipendente dalla chiave Fernet e >= 32 caratteri.
APP_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Per lo sviluppo locale rapido, se non hai ancora un'istanza PostgreSQL,
# puoi usare SQLite (decommentando la riga sotto):
# DATABASE_URL=sqlite:///./aip_dev.db

# Per collegarsi a PostgreSQL (es. Supabase):
# Formato: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL=postgresql+psycopg2://postgres:tua_password_sicura@db.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Crittografia Applicativa dei Dati Sanitari (PII e note cliniche)
# ------------------------------------------------------------------------------
# La chiave deve essere una stringa Fernet valida (32 byte codificati in base64 URL-safe).
# Puoi generare una chiave valida eseguendo in terminale:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Nessun fallback: valorizzare esplicitamente anche in sviluppo/test.
# Per database esistenti conservare la chiave corrente; NON generarne una sostitutiva.
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. Configurazione Host e Porta
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
